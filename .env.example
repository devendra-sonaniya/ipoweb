# Server-only MongoDB connection settings.
MONGODB_URI=
MONGODB_DB=ipoweb

# Long, random server-only key required by POST/PUT/DELETE /api/ipos.
ADMIN_API_KEY=

# Public canonical origin used for server-side API fetches.
NEXT_PUBLIC_SITE_URL=https://ipoweb.in

# Public Google Analytics 4 measurement ID.
NEXT_PUBLIC_GA_MEASUREMENT_ID=
